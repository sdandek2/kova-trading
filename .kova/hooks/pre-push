#!/bin/bash
# Kova pre-push hook — runs rule_validation_test.py before every push
# WARNS on failure but never blocks deployment. Fix immediately after push.

BACKEND_DIR="$(git rev-parse --show-toplevel)/backend"
TEST_SCRIPT="$BACKEND_DIR/scripts/rule_validation_test.py"

echo ""
echo "🔍 Running Kova rule validation..."

cd "$BACKEND_DIR" && python3 "$TEST_SCRIPT"
EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
    echo ""
    echo "⚠️  Rule validation FAILED — but push is proceeding."
    echo "   ⚡ Fix the failing checks immediately after this push."
    echo ""
else
    echo ""
    echo "✅ Rule validation passed — all good."
    echo ""
fi

exit 0  # always allow push
